#include "PWM_Functions.h"
#include "stm32f446xx.h"

void PMW_init(void)
{
	//Enable the clock for timer 2
	RCC->APB1ENR |= (1<<0);

	//Configure the timer
	TIM2->PSC =15999; // 16000 - 1
	TIM2->ARR =2999; //3000 - 1

	//Enable timer
	TIM2->CR1 |=(1<<0);

	//Enable Interrupt
	TIM2->DIER |= (1<<0);

	//NVIC enable
	NVIC_EnableIRQ(TIM2_IRQn);

}
